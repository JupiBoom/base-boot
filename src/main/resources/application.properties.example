# Spring Boot Configuration
spring.application.name=file-manager-system
spring.profiles.active=dev

# Database Configuration
spring.datasource.url=jdbc:mysql://localhost:3306/file_manager?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=GMT%2B8
spring.datasource.username=root
spring.datasource.password=password
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA Configuration
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQL8Dialect
spring.jpa.properties.hibernate.format_sql=true

# Redis Configuration
spring.redis.host=localhost
spring.redis.port=6379
spring.redis.password=
spring.redis.database=0
spring.redis.timeout=3000ms

# File Upload Configuration
file.upload.path=/opt/file-manager/upload
file.upload.temp.path=/opt/file-manager/temp
file.quarantine.path=/opt/file-manager/quarantine
file.preview.base-url=http://localhost:8080

# ClamAV Configuration
clamav.host=localhost
clamav.port=3310

# Server Configuration
server.port=8080
server.servlet.context-path=/

# Multipart Configuration
spring.servlet.multipart.enabled=true
spring.servlet.multipart.max-file-size=10GB
spring.servlet.multipart.max-request-size=10GB
spring.servlet.multipart.file-size-threshold=1MB

# Logging Configuration
logging.level.com.filemanager=INFO
logging.file.name=/opt/file-manager/logs/file-manager.log
logging.pattern.console=%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n
# Security Configuration
spring.security.user.name=admin
spring.security.user.password=admin123
spring.security.user.roles=ADMIN
